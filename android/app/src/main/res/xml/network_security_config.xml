<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public internet endpoints MUST use TLS / HTTPS. User-installed
         certificate authorities are deliberately NOT trusted: trusting
         them would let any CA the user installs (or is tricked into
         installing) decrypt and tamper with all Noctra traffic, including
         update metadata. System CAs only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permit cleartext traffic only for local loopback development endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
